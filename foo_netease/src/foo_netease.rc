// foo_netease 资源脚本。
//
// 注意：这里刻意只用 ASCII 文案。rc.exe 对没有 BOM 的 UTF-8 源文件处理不一致，
// 中文界面文案一律由 C++ 在 OnInitDialog 里用 UTF-8 字符串设置
// （见 login_ui.cpp / preferences.cpp），这样编码问题只在一个地方出现。

#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_NETEASE_PREFS DIALOGEX 0, 0, 320, 190
STYLE DS_SETFONT | WS_CHILD
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Status:",IDC_NETEASE_STATUS_LBL,12,12,40,10
    LTEXT           "",IDC_NETEASE_STATUS,56,12,252,10
    LTEXT           "Account:",IDC_NETEASE_ACCOUNT_LBL,12,30,40,10
    LTEXT           "",IDC_NETEASE_ACCOUNT,56,30,252,10
    PUSHBUTTON      "QR code",IDC_NETEASE_LOGIN_BTN,12,48,72,16
    PUSHBUTTON      "Sign out",IDC_NETEASE_LOGOUT_BTN,12,68,72,16
    PUSHBUTTON      "Browse",IDC_NETEASE_BROWSE_BTN,192,68,72,16
    PUSHBUTTON      "Clear all data",IDC_NETEASE_CLEAR,90,68,96,16
    LTEXT           "Quality:",IDC_NETEASE_QUALITY_LBL,12,94,40,10
    COMBOBOX        IDC_NETEASE_QUALITY,56,92,140,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Cover follows now playing",IDC_NETEASE_COVER_NOW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,200,92,112,12
    CONTROL         "Follow playing track in playlist",IDC_NETEASE_FOLLOW_CURSOR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,110,300,12
    LTEXT           "",IDC_NETEASE_HINT,12,128,296,30
    PUSHBUTTON      "Panel",IDC_NETEASE_PANEL_BTN,12,164,108,16
END

IDD_NETEASE_LOGIN DIALOGEX 0, 0, 264, 322
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Netease Cloud Music"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_LOGIN_HINT,12,8,240,26
    CONTROL         "",IDC_LOGIN_QR,"Static",SS_BITMAP | SS_CENTERIMAGE | WS_BORDER,32,38,200,200
    LTEXT           "",IDC_LOGIN_STATUS,12,246,240,30
    PUSHBUTTON      "Refresh",IDC_LOGIN_REFRESH,72,282,60,16
    DEFPUSHBUTTON   "Cancel",IDCANCEL,136,282,60,16
END



IDD_NETEASE_BROWSE DIALOGEX 0, 0, 660, 388
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
CAPTION "Netease Cloud Music"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_BROWSE_PLAYLISTS,8,30,208,326,LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_BROWSE_ACCOUNT,8,8,208,18
    EDITTEXT        IDC_BROWSE_SEARCH,228,10,300,15,ES_AUTOHSCROLL
    PUSHBUTTON      "Search",IDC_BROWSE_SEARCH_BTN,534,9,50,17
    PUSHBUTTON      "Refresh",IDC_BROWSE_REFRESH,590,9,58,17
    CONTROL         "",IDC_BROWSE_TRACKS,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,228,32,420,300
    LTEXT           "",IDC_BROWSE_STATUS,228,338,420,14
    PUSHBUTTON      "Add to playlist",IDC_BROWSE_ADD,228,358,100,18
    PUSHBUTTON      "Replace playlist",IDC_BROWSE_REPLACE,336,358,110,18
END

